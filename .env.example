# Neon Postgres (Singapore region — see docs/TECH_STACK.md).
#
# Pooled, app_user role — the app's normal query traffic (src/db/client.ts).
# app_user must be created with plain SQL, NOT `neon roles create` / the
# console — those grant BYPASSRLS and silently defeat every RLS policy.
# See docs/TECH_STACK.md "Neon role setup" for the exact CREATE ROLE/GRANT
# statements and why.
DATABASE_URL=postgresql://app_user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
#
# Direct/unpooled, owner role — schema migrations only (drizzle.config.ts).
# Neon's pooled connection runs PgBouncer in transaction mode, which doesn't
# suit drizzle-kit's migration session, and migrations need DDL privileges
# app_user intentionally doesn't have.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible) — product images + order screenshots.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# better-auth — see docs/plans/better-auth-migration.md.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated user ids permitted to impersonate a tenant's user for
# support. Every impersonated session is recorded in the audit table —
# see docs/adr/0002-multi-tenancy-mvp.md.
PLATFORM_ADMIN_USER_IDS=

# Resend — transactional email (account credentials). See
# docs/adr/0005-transactional-email.md. suseeos.com must be a verified
# sending domain in the Resend dashboard (SPF + DKIM DNS records) before
# anything sends. Without RESEND_API_KEY the server still boots; creating a
# user or resetting a password fails at the send step.
RESEND_API_KEY=
# Optional override of the From header; defaults to the value below.
EMAIL_FROM=SuSeeOS <support@suseeos.com>
# Optional. The app's public origin, used for the sign-in link in emails.
# Falls back to BETTER_AUTH_URL, then the Vercel-provided host, then
# http://localhost:3000.
APP_BASE_URL=
